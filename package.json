  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:ledger": "node scripts/check-ledger.mjs",
    "check:p1-review": "node scripts/check-p1-review.mjs",
    "check:p1-values": "node scripts/check-p1-values.mjs",
    "check:p1-json": "node scripts/check-p1-json.mjs",
    "check:p1-patch": "node scripts/check-p1-patch.mjs",
    "check:p1-boundary": "node scripts/check-p1-boundary.mjs",
    "check:p1-families": "node scripts/check-p1-families.mjs",
    "check:p1-zones": "node scripts/check-p1-zones.mjs",
    "check:p1-store": "node scripts/check-p1-store.mjs",
    "check:p1-history": "node scripts/check-p1-history.mjs",
    "check:p1-desktop-source": "node scripts/check-p1-desktop-source.mjs",
    "check:p1-canonical": "node scripts/check-p1-canonical.mjs",
